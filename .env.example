# Copy to .env.local for development. On Vercel, add each as an environment variable. Never commit real values.

# Email intake (Resend). Until these are set, /api/contact answers 503 and the forms tell the visitor to use WhatsApp.
RESEND_API_KEY=
CONTACT_TO_EMAIL=owner@example.com
CONTACT_FROM_EMAIL="Modern Furniture Collection <onboarding@resend.dev>"

# Budget estimator. "true" shows the /estimator page, the home section and the chatbot links.
# A Vercel PRODUCTION build fails while this is true and config/pricing.config.ts still has PLACEHOLDER_DATA = true.
ESTIMATOR_ENABLED=false

# AI assistant (Phase 2). Off by default; the keyword matcher answers when this is false or the key is missing.
# Both values are read at build time for the chat bubble's label and openers, so redeploy after changing them
# (a Vercel redeploy does this). The /api/chat route reads them at request time as well.
AI_CHAT_ENABLED=false
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5

# Rate limiting for /api/estimate, /api/contact and /api/chat. Create an Upstash Redis database through the
# Vercel Marketplace and paste its REST values. Without them a per-instance in-memory limiter is used and a warning
# is logged once; that is acceptable for preview, not for production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile on lead forms. Both empty: the widget is not rendered and tokens are not checked.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
