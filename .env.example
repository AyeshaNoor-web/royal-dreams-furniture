# Email intake (Resend). Leave empty until the account is ready; the form still works and
# shows a success state, but nothing is delivered.
RESEND_API_KEY=
CONTACT_TO_EMAIL=owner@example.com
CONTACT_FROM_EMAIL="Modern Furniture Collection <onboarding@resend.dev>"

# AI chat assistant on Groq's free plan (console.groq.com, no card needed). Leave empty and the chat
# uses its built-in answers instead.
GROQ_API_KEY=
